# ============================================================
# BankGuard AI — Environment Configuration
# Copy to .env and fill in real values
# NEVER commit .env to source control
# ============================================================

# ----- Application -----
APP_ENV=development                    # development | staging | production
APP_SECRET_KEY=change-me-generate-256-bit-random
LOG_LEVEL=INFO
API_PORT=8000

# ----- AWS -----
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
# EC2 uses IAM Instance Role — no static credentials in production
# For local dev only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ----- Amazon Bedrock -----
BEDROCK_DEFAULT_MODEL=us.amazon.nova-micro-v1:0
BEDROCK_FALLBACK_MODEL=us.amazon.nova-lite-v1:0
BEDROCK_REGION=ap-south-1

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bankguard
POSTGRES_USER=bankguard
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://bankguard:change-me-strong-password@localhost:5432/bankguard

# ----- Valkey / Redis -----
VALKEY_URL=redis://localhost:6379/0

# ----- Langfuse (OSS self-hosted) -----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me

# ----- OpenTelemetry -----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=bankguard-api
OTEL_ENVIRONMENT=development

# ----- Cognito -----
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_REGION=ap-south-1

# ----- S3 -----
S3_BUCKET_POLICIES=bankguard-policies
S3_BUCKET_BACKUPS=bankguard-backups
S3_BUCKET_EVALS=bankguard-evals

# ----- SSM Parameter Store -----
SSM_PREFIX=/bankguard/

# ----- Temporal -----
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=bankguard

# ----- Agent Harness Limits -----
MAX_AGENT_ITERATIONS=8
MAX_TOOL_CALLS=15
MAX_COST_PER_CASE_USD=0.15
TOOL_TIMEOUT_SECONDS=10
MODEL_TIMEOUT_SECONDS=30
MAX_RETRIES=2
MAX_PARALLEL_TOOLS=4
TOKEN_BUDGET_INPUT=50000
TOKEN_BUDGET_OUTPUT=10000

# ----- OPA -----
OPA_URL=http://localhost:8181

# ----- Embeddings -----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ----- CORS -----
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
