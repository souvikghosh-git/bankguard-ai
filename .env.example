# ============================================================
# BankGuard AI — Environment Configuration Template
#
# Copy to .env and fill in values before running.
# NEVER commit .env to source control — it is in .gitignore.
#
# AWS CREDENTIAL POLICY (read before editing):
#   Production (EC2): Leave AWS_ACCESS_KEY_ID and
#     AWS_SECRET_ACCESS_KEY commented out. Attach an IAM Instance
#     Role to the EC2 instance. The boto3/botocore credential chain
#     resolves it automatically via the Instance Metadata Service.
#
#   Local dev with Bedrock: Run `aws configure --profile bankguard`
#     and set AWS_PROFILE=bankguard below. Never paste keys here.
#
#   Local dev without AWS: Use OpenAI via LiteLLM.
#     Set OPENAI_API_KEY instead (see .env.local.example).
#
#   CI/CD: Inject AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY as
#     GitHub Actions secrets. They must never appear in any file
#     committed to the repository.
# ============================================================

# ----- Application -----
APP_ENV=development                    # development | staging | production
APP_SECRET_KEY=change-me-generate-256-bit-random
LOG_LEVEL=INFO
API_PORT=8000

# ----- AWS region (no credentials here) -----
AWS_REGION=ap-south-1
# Use a named profile for local Bedrock access.
# Leave blank on EC2 — the Instance Role is used automatically.
# AWS_PROFILE=bankguard
#
# NEVER set these in this file:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ----- Amazon Bedrock -----
BEDROCK_DEFAULT_MODEL=amazon.nova-micro-v1:0
BEDROCK_FALLBACK_MODEL=amazon.nova-lite-v1:0
BEDROCK_REGION=ap-south-1

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bankguard
POSTGRES_USER=bankguard
# Use a strong random password in all non-dev environments.
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://bankguard:change-me-strong-password@localhost:5432/bankguard

# ----- Valkey / Redis -----
VALKEY_URL=redis://localhost:6379/0

# ----- Langfuse (OSS self-hosted) -----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
# Required by Langfuse v2 — must be >= 32 chars each
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret-32-chars!!
LANGFUSE_SALT=change-me-langfuse-salt-32-chars!!

# ----- OpenTelemetry -----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=bankguard-api
OTEL_ENVIRONMENT=development

# ----- Cognito (production auth — leave blank for local dev) -----
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-south-1

# ----- S3 -----
S3_BUCKET_POLICIES=bankguard-policies
S3_BUCKET_BACKUPS=bankguard-backups
S3_BUCKET_EVALS=bankguard-evals

# ----- SSM Parameter Store prefix -----
SSM_PREFIX=/bankguard/

# ----- Temporal -----
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=bankguard

# ----- Agent Harness Limits -----
MAX_AGENT_ITERATIONS=8
MAX_TOOL_CALLS=15
MAX_COST_PER_CASE_USD=0.15
TOOL_TIMEOUT_SECONDS=10
MODEL_TIMEOUT_SECONDS=30
MAX_RETRIES=2
MAX_PARALLEL_TOOLS=4
TOKEN_BUDGET_INPUT=50000
TOKEN_BUDGET_OUTPUT=10000

# ----- OPA -----
OPA_URL=http://localhost:8181

# ----- Embeddings -----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ----- Grafana admin (production only) -----
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# ----- CORS -----
CORS_ORIGINS=http://localhost:8501,http://localhost:3001
