# BankGuard AI — Local development with OpenAI (no AWS required)
# Copy to .env when developing locally without Bedrock.
#
# cp .env.local.example .env

APP_ENV=development
APP_SECRET_KEY=local-dev-secret-change-this-in-production
LOG_LEVEL=INFO
API_PORT=8000

# ── LLM: OpenAI (swap for Bedrock when deploying to AWS) ─────────────────────
# LiteLLM auto-routes gpt-4o-mini → OpenAI if OPENAI_API_KEY is set.
OPENAI_API_KEY=sk-your-openai-key-here
BEDROCK_DEFAULT_MODEL=gpt-4o-mini
BEDROCK_FALLBACK_MODEL=gpt-4o

# ── PostgreSQL (local Docker) ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bankguard
POSTGRES_USER=bankguard
POSTGRES_PASSWORD=bankguard_dev_password
DATABASE_URL=postgresql+asyncpg://bankguard:bankguard_dev_password@localhost:5432/bankguard

# ── Valkey (local Docker) ─────────────────────────────────────────────────────
VALKEY_URL=redis://localhost:6379/0

# ── Langfuse (local Docker) ───────────────────────────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# ── OpenTelemetry (disabled locally — just logs) ─────────────────────────────
# Set to a running OTel collector if you want traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=bankguard-api-local
OTEL_ENVIRONMENT=development

# ── Cognito (not needed locally) ─────────────────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── OPA (local Docker) ───────────────────────────────────────────────────────
OPA_URL=http://localhost:8181

# ── Temporal (optional locally) ──────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=bankguard

# ── Agent Harness ─────────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=8
MAX_TOOL_CALLS=15
MAX_COST_PER_CASE_USD=0.15
TOOL_TIMEOUT_SECONDS=10
MODEL_TIMEOUT_SECONDS=30
MAX_PARALLEL_TOOLS=4
TOKEN_BUDGET_INPUT=50000
TOKEN_BUDGET_OUTPUT=10000

# ── Embeddings (CPU, no GPU needed) ──────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8501,http://localhost:3001
