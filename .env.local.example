# BankGuard AI — Local development with OpenAI (no AWS required)
# Copy to .env for fully local dev:
#   cp .env.local.example .env
#
# Then edit OPENAI_API_KEY.
# No AWS credentials are needed or used with this config.

APP_ENV=development
APP_SECRET_KEY=local-dev-secret-change-for-staging
LOG_LEVEL=INFO
API_PORT=8000

# ----- LLM: OpenAI via LiteLLM -----
# LiteLLM routes gpt-4o-mini → OpenAI when OPENAI_API_KEY is set.
# The BEDROCK_* vars below just set the model names; the "bedrock/"
# prefix is skipped because LiteLLM detects "gpt-" and routes to OpenAI.
OPENAI_API_KEY=sk-your-openai-key-here
BEDROCK_DEFAULT_MODEL=gpt-4o-mini
BEDROCK_FALLBACK_MODEL=gpt-4o

# No AWS vars needed for local OpenAI mode.
# If you want to test Bedrock locally, add AWS_PROFILE=your-profile
# and change BEDROCK_DEFAULT_MODEL back to amazon.nova-micro-v1:0

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bankguard
POSTGRES_USER=bankguard
POSTGRES_PASSWORD=bankguard_dev_password
DATABASE_URL=postgresql+asyncpg://bankguard:bankguard_dev_password@localhost:5432/bankguard

# ----- Valkey -----
VALKEY_URL=redis://localhost:6379/0

# ----- Langfuse -----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_NEXTAUTH_SECRET=local-dev-nextauth-secret-32-chars!!
LANGFUSE_SALT=local-dev-langfuse-salt-32-chars!!

# ----- OTel -----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=bankguard-api-local
OTEL_ENVIRONMENT=development

# ----- Cognito — disabled locally -----
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ----- OPA -----
OPA_URL=http://localhost:8181

# ----- Temporal -----
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=bankguard

# ----- Agent limits -----
MAX_AGENT_ITERATIONS=8
MAX_TOOL_CALLS=15
MAX_COST_PER_CASE_USD=0.15
TOOL_TIMEOUT_SECONDS=10
MODEL_TIMEOUT_SECONDS=30
MAX_RETRIES=2
MAX_PARALLEL_TOOLS=4
TOKEN_BUDGET_INPUT=50000
TOKEN_BUDGET_OUTPUT=10000

# ----- Embeddings (CPU) -----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ----- Grafana (local — weak password fine) -----
GRAFANA_ADMIN_PASSWORD=admin

# ----- CORS -----
CORS_ORIGINS=http://localhost:8501,http://localhost:3001

# ----- S3 (optional locally) -----
S3_BUCKET_POLICIES=bankguard-policies
S3_BUCKET_BACKUPS=bankguard-backups
S3_BUCKET_EVALS=bankguard-evals
SSM_PREFIX=/bankguard/
